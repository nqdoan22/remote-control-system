# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765

# JWT Secret — dùng để validate token từ Web App
# Phải khớp với JWT_SECRET trong Web App backend
JWT_SECRET=change-this-to-a-long-random-secret

# Heartbeat (giây)
HEARTBEAT_TIMEOUT=45

# Permission confirmation timeout (giây)
PERMISSION_TIMEOUT=30

# Command timeout — nếu Client App không phản hồi trong khoảng này thì trả lỗi TIMEOUT (giây)
COMMAND_TIMEOUT=15

# Auth rate limiting — chống brute-force machineSecret
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=60

# Danh sách machines được phép kết nối (machineId:machineSecret, phân cách bằng dấu phẩy)
# Ví dụ: REGISTERED_MACHINES=machine-uuid-1:secret1,machine-uuid-2:secret2
REGISTERED_MACHINES=
