# ==========================================================================
# Client App (Agent) - Mau cau hinh moi truong
# Sao chep file nay thanh  .env  va chinh lai cho phu hop.
# ==========================================================================

# --- Ket noi Gateway ---
# Phai khop route "/client" cua Gateway. Neu Gateway o may khac, thay 127.0.0.1
# bang IP LAN cua may chay Gateway.
GATEWAY_WS_URL=ws://127.0.0.1:8765/client
RECONNECT_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=5

# --- Dinh danh Agent ---
# CLIENT_ID / CLIENT_SECRET phai khop mot entry trong REGISTERED_MACHINES cua Gateway.
CLIENT_ID=client-my-pc
CLIENT_SECRET=DEFAULT_SECRET_KEY_123

# --- Bao mat & quyen rieng tu ---
PERMISSION_TIMEOUT_SECONDS=15
SANDBOX_DIR=C:/AgentSandbox
RED_INDICATOR_ENABLED=true

# --- Hieu nang streaming ---
SCREEN_FPS=10
WEBCAM_FPS=15
JPEG_QUALITY=60
